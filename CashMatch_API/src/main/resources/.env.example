# Plantilla. Copia a ".env" y reemplaza los valores. NO subas ".env" al repositorio.
DB_USER=cashmatch_admin
# PLACEHOLDER: reemplaza por una contrasena propia y fuerte (p. ej. `openssl rand -hex 24`)
DB_PASSWORD=CAMBIAME_placeholder_no_usar
# Puerto del host (loopback). 5433 evita chocar con un Postgres local en 5432.
DB_PORT=5433
